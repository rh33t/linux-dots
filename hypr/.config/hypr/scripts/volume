#!/usr/bin/env bash
set -euo pipefail

VOLUME_STEP=1
MAX_VOLUME=100
WOBSOCK="${WOBSOCK:-${XDG_RUNTIME_DIR:-/tmp}/wob.sock}"

command -v pactl >/dev/null 2>&1 || { echo "pactl not found" >&2; exit 1; }

report() {
  local sink="$1"
  local vol muted
  vol=$(pactl get-sink-volume "$sink" | grep -Po '[0-9]{1,3}(?=%)' | head -1)
  muted=$(pactl get-sink-mute "$sink" | grep -q "yes" && echo 1 || echo 0)
  if [[ "$muted" == "1" ]]; then
    echo "0 muted" > "$WOBSOCK"
  else
    echo "$vol" > "$WOBSOCK"
  fi
}

report_source() {
  local source="$1"
  local vol muted
  vol=$(pactl get-source-volume "$source" | grep -Po '[0-9]{1,3}(?=%)' | head -1)
  muted=$(pactl get-source-mute "$source" | grep -q "yes" && echo 1 || echo 0)
  if [[ "$muted" == "1" ]]; then
    echo "0 muted" > "$WOBSOCK"
  else
    echo "$vol" > "$WOBSOCK"
  fi
}

case "${1:-}" in
  up)
    pactl set-sink-mute @DEFAULT_SINK@ 0
    vol=$(pactl get-sink-volume @DEFAULT_SINK@ | grep -Po '[0-9]{1,3}(?=%)' | head -1)
    if (( vol + VOLUME_STEP > MAX_VOLUME )); then
      pactl set-sink-volume @DEFAULT_SINK@ "${MAX_VOLUME}%"
    else
      pactl set-sink-volume @DEFAULT_SINK@ "+${VOLUME_STEP}%"
    fi
    report @DEFAULT_SINK@
    ;;
  down)
    pactl set-sink-volume @DEFAULT_SINK@ "-${VOLUME_STEP}%"
    report @DEFAULT_SINK@
    ;;
  mute)
    pactl set-sink-mute @DEFAULT_SINK@ toggle
    report @DEFAULT_SINK@
    ;;
  mic-mute)
    pactl set-source-mute @DEFAULT_SOURCE@ toggle
    report_source @DEFAULT_SOURCE@
    ;;
  *)
    echo "Usage: $0 up|down|mute|mic-mute" >&2
    exit 1
    ;;
esac
