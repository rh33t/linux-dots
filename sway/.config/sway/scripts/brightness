#!/usr/bin/env bash
set -euo pipefail

BAR_COLOR="#7f7fff"

for cmd in brightnessctl dunstify; do
  command -v "$cmd" >/dev/null 2>&1 || { echo "$cmd not found" >&2; exit 1; }
done

get_brightness() {
  brightnessctl --machine-readable get | cut -d, -f4 | tr -d '%'
}

send_notification() {
  local bper
  bper=$(get_brightness)
  dunstify -t 1000 -r 2593 -u normal "🔆 $bper%" \
    -h int:value:"$bper" \
    -h string:hlcolor:"$BAR_COLOR"
}

case "${1:-}" in
  up)
    brightnessctl set +5%
    send_notification
    ;;
  down)
    brightnessctl set 5%-
    send_notification
    ;;
  *)
    echo "Usage: $0 up|down" >&2
    exit 1
    ;;
esac